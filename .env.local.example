# Supabase (optional) — the app falls back to data/db.json when unset.
# Project Settings → API → Project URL + service_role key (server-only, never expose the anon key here).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Laaffic SMS (optional) — send real OTP texts; without these, codes are
# returned as dev_code in the API response (demo mode).
# LAAFFIC_APP_ID=
# LAAFFIC_API_KEY=
# LAAFFIC_API_SECRET=
# LAAFFIC_SENDER_ID=

# Optional
# SG_ADMIN_USER=admin
# SG_ADMIN_PASS=sprinter123
# SG_AUTOREPLY=0
# SG_AUTH_WAOTP=1
# SG_AUTH_WAMSG=1
# SG_AUTH_PASSWORD=1
